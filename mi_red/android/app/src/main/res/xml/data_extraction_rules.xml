<?xml version="1.0" encoding="utf-8"?>
<!-- La sesión de Supabase se guarda en el teléfono; no debe copiarse a
     respaldos en la nube ni a otro teléfono (se inicia sesión de nuevo). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
